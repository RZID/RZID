    "prepare": "husky"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "^5.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "clsx": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.1",
    "oxlint": "^1.94.0",
    "oxlint-tsgolint": "^7.0.2007",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "~7.0.2",
    "vite": "^8.3.6"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
