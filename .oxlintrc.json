{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc", "import", "unicorn", "jsx-a11y"],
  "categories": { "correctness": "error" },
  "ignorePatterns": ["build", "dist", "scripts/**"],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/only-export-components": ["warn", { "allowConstantExport": true }],

    "no-var": "error",
    "prefer-const": "error",
    "func-style": ["error", "expression"],
    "prefer-arrow-callback": "error",
    "eqeqeq": "error",
    "curly": "error",
    "no-nested-ternary": "error",
    "no-param-reassign": "error",
    "no-console": "warn",
    "max-lines": ["error", { "max": 300, "skipBlankLines": true, "skipComments": true }],

    "typescript/no-explicit-any": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/consistent-type-assertions": ["error", { "assertionStyle": "never" }],
    "typescript/consistent-type-definitions": ["error", "type"],
    "typescript/consistent-type-imports": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-floating-promises": "error",

    "import/no-default-export": "error",
    "unicorn/filename-case": ["error", { "case": "kebabCase" }]
  },
  "overrides": [
    {
      "files": ["vite.config.ts"],
      "rules": { "import/no-default-export": "off" }
    },
    {
      "files": ["src/components/**", "src/hooks/**", "src/lib/**", "src/content/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*", "@/app/*"],
                "message": "Shared layers must not import features or app."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/features/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/features/*/*"],
                "message": "Import other features only through their index.ts."
              },
              { "group": ["@/app/*"], "message": "Features must not import app." },
              {
                "group": ["../**"],
                "message": "Use the @/ alias instead of parent-relative paths."
              }
            ]
          }
        ]
      }
    }
  ]
}
